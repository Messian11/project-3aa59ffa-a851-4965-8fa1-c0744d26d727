{
  "$schema": "https://lovable.dev/zaymi/tokens.schema.json",
  "name": "Zaymi Online Design Tokens",
  "version": "1.0.0",
  "description": "Семантические токены дизайн-системы. Источник: src/styles.css",

  "color": {
    "brand": {
      "blue":          { "value": "#2563eb", "description": "Основной бренд-цвет, ссылки, акценты" },
      "blueForeground":{ "value": "#ffffff" },
      "green":         { "value": "#10b981", "description": "CTA-кнопки, успех, primary" },
      "greenForeground":{ "value": "#ffffff" },
      "amber":         { "value": "#f59e0b", "description": "Рейтинги, звёзды, warning" },
      "amberForeground":{ "value": "#1f1300" },
      "danger":        { "value": "#ef4444", "description": "Ошибки, минусы, отмена" },
      "ink":           { "value": "#172033", "description": "Основной текст" },
      "muted":         { "value": "#647084", "description": "Приглушённый текст" },
      "line":          { "value": "#e5edf5", "description": "Границы, разделители" },
      "soft":          { "value": "#f6fbff", "description": "Мягкий фон секций" },
      "dark":          { "value": "#0f172a", "description": "Тёмный фон футера" }
    },
    "semantic": {
      "background":    { "value": "#ffffff" },
      "foreground":    { "value": "#172033" },
      "card":          { "value": "#ffffff" },
      "cardForeground":{ "value": "#172033" },
      "primary":       { "value": "#10b981" },
      "primaryForeground":{ "value": "#ffffff" },
      "secondary":     { "value": "#2563eb" },
      "secondaryForeground":{ "value": "#ffffff" },
      "muted":         { "value": "#f6fbff" },
      "mutedForeground":{ "value": "#647084" },
      "accent":        { "value": "#f6fbff" },
      "accentForeground":{ "value": "#172033" },
      "destructive":   { "value": "#ef4444" },
      "destructiveForeground":{ "value": "#ffffff" },
      "border":        { "value": "#e5edf5" },
      "input":         { "value": "#e5edf5" },
      "ring":          { "value": "#2563eb" }
    }
  },

  "gradient": {
    "hero": {
      "value": "radial-gradient(circle at 75% 15%, rgba(16,185,129,0.14), transparent 25%), radial-gradient(circle at 15% 18%, rgba(37,99,235,0.13), transparent 28%), linear-gradient(180deg, #f8fbff, #eefdf6 78%, #fff)",
      "description": "Фон главного hero-блока"
    },
    "page": {
      "value": "linear-gradient(180deg, #f7fbff 0, #fff 420px)",
      "description": "Фон внутренних страниц"
    }
  },

  "radius": {
    "sm":  { "value": "8px" },
    "md":  { "value": "14px" },
    "lg":  { "value": "22px" },
    "xl":  { "value": "28px" },
    "2xl": { "value": "32px" },
    "pill":{ "value": "999px" }
  },

  "shadow": {
    "card":   { "value": "0 12px 28px rgba(15, 23, 42, 0.045)" },
    "hover":  { "value": "0 22px 45px rgba(15, 23, 42, 0.08)" },
    "sticky": { "value": "0 12px 36px rgba(15, 23, 42, 0.05)" }
  },

  "typography": {
    "fontFamily": {
      "sans": { "value": "Inter, ui-sans-serif, system-ui, -apple-system, sans-serif" }
    },
    "fontWeight": {
      "regular": { "value": 500, "description": "Базовый вес body — намеренно повышен" },
      "semibold":{ "value": 600 },
      "bold":    { "value": 700 },
      "extrabold":{ "value": 800, "description": "Все заголовки H1-H6" }
    },
    "letterSpacing": {
      "headings": { "value": "-0.02em" },
      "uppercase":{ "value": "0.16em", "description": "Малые аптайтлы" }
    },
    "scale": {
      "h1": { "fontSize": "clamp(2.25rem, 4vw, 3.5rem)", "lineHeight": "1.05", "weight": 800 },
      "h2": { "fontSize": "clamp(1.875rem, 3vw, 2.75rem)", "lineHeight": "1.1",  "weight": 800 },
      "h3": { "fontSize": "clamp(1.5rem, 2.4vw, 2rem)",    "lineHeight": "1.2",  "weight": 800 },
      "h4": { "fontSize": "1.25rem", "lineHeight": "1.3",  "weight": 700 },
      "body":   { "fontSize": "1rem",   "lineHeight": "1.6", "weight": 500 },
      "small":  { "fontSize": "0.875rem","lineHeight": "1.5","weight": 500 },
      "caption":{ "fontSize": "0.75rem", "lineHeight": "1.4","weight": 600 }
    }
  },

  "spacing": {
    "0":  "0",
    "1":  "0.25rem",
    "2":  "0.5rem",
    "3":  "0.75rem",
    "4":  "1rem",
    "5":  "1.25rem",
    "6":  "1.5rem",
    "8":  "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem"
  },

  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },

  "container": {
    "maxWidth": "80rem",
    "padding": { "default": "1rem", "md": "1.5rem", "lg": "2rem" }
  }
}
